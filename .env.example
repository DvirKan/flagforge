# ─────────────────────────────────────────────────────────────
# FLAGFORGE environment — copy to .env.local and fill in.
# NEVER commit .env.local. NEVER put a secret in a NEXT_PUBLIC_ variable.
# ─────────────────────────────────────────────────────────────

# Public site URL (metadata, auth email redirects). Production: https://your-domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: override the provisional brand name
# NEXT_PUBLIC_BRAND_NAME=FLAGFORGE

# Server-only. Encrypts standard-game session tokens (they contain the answers). ≥ 32 random characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GAME_SESSION_SECRET=

# Supabase — Project Settings → API Keys. Without these the app runs in guest-only mode.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_…) — safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) — SERVER-ONLY. Used for authoritative game writes, account deletion, admin.
SUPABASE_SECRET_KEY=

# Legacy key names are also accepted: NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY

# Integration tests only (plain PostgreSQL ≥ 15 where this user can create databases):
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
